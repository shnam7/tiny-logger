{
  "name": "tiny-logger",
  "version": "0.9.0",
  "description": "A lightweight logger with ts-log interface providing colored output.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts",
        "default": "./dist/index.d.mts"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --dts",
    "lint": "run-p lint:*",
    "lint:ts": "biome check",
    "lint:ts:types": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "clean": "rimraf ./dist ./coverage",
    "prepublishOnly": "bun run build",
    "npm-dry-run": "npm publish --dry-run",
    "rebuild": "run-s clean build",
    "reset": "npm-run-all clean --parallel reset:*",
    "reset:turbo": "find . -type d -name .turbo -exec rm -rf {} +",
    "reset:node": "find . -type d -name node_modules -exec rm -rf {} +",
    "prepare-to-commit": "run-s lint test build clean"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shnam7/tiny-logger.git"
  },
  "homepage": "https://github.com/shnam7/tiny-logger#readme",
  "bugs": {
    "url": "https://github.com/shnam7/tiny-logger/issues"
  },
  "author": "Robin Nam (https://github.com/shnam7)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "lightweight",
    "minimal",
    "logger",
    "ts-log",
    "pino",
    "ansi",
    "prefix",
    "coloring"
  ],
  "dependencies": {
    "pino": "^10.3.1",
    "ts-log": "^3.0.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "npm-run-all2": "^9.0.3",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "bun@1.3.14"
}
